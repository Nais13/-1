#include "common.h"

#include <pthread.h>
#include <stdarg.h>
#include <stdio.h>
#include <string.h>
#include <time.h>

static pthread_mutex_t log_mutex = PTHREAD_MUTEX_INITIALIZER;

void log_message(const char *format, ...)
{
    pthread_mutex_lock(&log_mutex);

    FILE *file = fopen("app.log", "a");
    if (file != NULL) {
        time_t now = time(NULL);
        struct tm tm_now;
        char timestamp[32] = "unknown-time";

        if (localtime_r(&now, &tm_now) != NULL) {
            strftime(timestamp, sizeof(timestamp),
                     "%Y-%m-%d %H:%M:%S", &tm_now);
        }

        fprintf(file, "[%s] ", timestamp);

        va_list args;
        va_start(args, format);
        vfprintf(file, format, args);
        va_end(args);

        fputc('\n', file);
        fclose(file);
    }

    pthread_mutex_unlock(&log_mutex);
}

int load_products(const char *path, Product *products, size_t capacity)
{
    FILE *file = fopen(path, "r");
    if (file == NULL) {
        log_message("Ошибка: не удалось открыть файл товаров %s", path);
        return -1;
    }

    char line[512];
    size_t count = 0;
    size_t line_number = 0;

    while (fgets(line, sizeof(line), file) != NULL) {
        line_number++;

        if (line_number == 1) {
            continue; /* Заголовок */
        }

        Product product;

        if (sscanf(line, "%d;%127[^;];%lf",
                   &product.code, product.name, &product.price) != 3) {
            log_message("Предупреждение: некорректная строка %zu в %s",
                        line_number, path);
            continue;
        }

        if (count >= capacity) {
            log_message("Превышен лимит товаров");
            break;
        }

        products[count++] = product;
    }

    fclose(file);
    return (int)count;
}

int load_buyers(const char *path, Buyer *buyers, size_t capacity)
{
    FILE *file = fopen(path, "r");
    if (file == NULL) {
        log_message("Ошибка: не удалось открыть файл покупателей %s", path);
        return -1;
    }

    char line[512];
    size_t count = 0;
    size_t line_number = 0;

    while (fgets(line, sizeof(line), file) != NULL) {
        line_number++;

        if (line_number == 1) {
            continue; /* Заголовок */
        }

        Buyer buyer;

        if (sscanf(line, "%d;%127[^\r\n]",
                   &buyer.code, buyer.name) != 2) {
            log_message("Предупреждение: некорректная строка %zu в %s",
                        line_number, path);
            continue;
        }

        if (count >= capacity) {
            log_message("Превышен лимит покупателей");
            break;
        }

        buyers[count++] = buyer;
    }

    fclose(file);
    return (int)count;
}

int load_sales(const char *path, Sale *sales, size_t capacity,
               size_t *malformed_lines)
{
    if (malformed_lines != NULL) {
        *malformed_lines = 0;
    }

    FILE *file = fopen(path, "r");
    if (file == NULL) {
        log_message("Ошибка: не удалось открыть файл продаж %s", path);
        return -1;
    }

    char line[512];
    size_t count = 0;
    size_t line_number = 0;

    while (fgets(line, sizeof(line), file) != NULL) {
        line_number++;

        if (line_number == 1) {
            continue; /* Заголовок */
        }

        Sale sale = {0};

        if (sscanf(line, "%d;%31[^;];%d;%d",
                   &sale.id, sale.datetime,
                   &sale.buyer_code, &sale.product_code) != 4) {
            if (malformed_lines != NULL) {
                (*malformed_lines)++;
            }

            log_message("Предупреждение: некорректная строка %zu в %s",
                        line_number, path);
            continue;
        }

        if (count >= capacity) {
            log_message("Превышен лимит записей продаж");
            break;
        }

        sale.valid = 0;
        sale.buyer_index = -1;
        sale.product_index = -1;
        sales[count++] = sale;
    }

    fclose(file);
    return (int)count;
}
3. simulator.c
Аргументы запуска: число потоков, интервал между продажами в миллисекундах, число продаж на поток, начальное значение генератора случайных чисел.

#include "common.h"

#include <pthread.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

typedef struct {
    int thread_id;
    int sales_per_thread;
    int interval_ms;
    unsigned int seed;

    Product *products;
    size_t product_count;
    Buyer *buyers;
    size_t buyer_count;

    FILE *sales_file;
    pthread_mutex_t *file_mutex;
    int *next_sale_id;
} WorkerArgs;

static void *simulate_sales(void *arg)
{
    WorkerArgs *args = (WorkerArgs *)arg;

    for (int i = 0; i < args->sales_per_thread; i++) {
        size_t product_index =
            (size_t)(rand_r(&args->seed) % args->product_count);

        size_t buyer_index =
            (size_t)(rand_r(&args->seed) % args->buyer_count);

        time_t now = time(NULL);
        struct tm tm_now;
        char datetime[32];

        if (localtime_r(&now, &tm_now) == NULL) {
            log_message("Поток %d: не удалось получить текущее время",
                        args->thread_id);
            continue;
        }

        strftime(datetime, sizeof(datetime),
                 "%Y-%m-%d %H:%M:%S", &tm_now);

        pthread_mutex_lock(args->file_mutex);

        int sale_id = (*args->next_sale_id)++;
        int result = fprintf(args->sales_file, "%d;%s;%d;%d\n",
                             sale_id,
                             datetime,
                             args->buyers[buyer_index].code,
                             args->products[product_index].code);

        if (result < 0 || fflush(args->sales_file) != 0) {
            log_message("Поток %d: ошибка записи продажи",
                        args->thread_id);
        } else {
            log_message("Поток %d: записана продажа %d",
                        args->thread_id, sale_id);
        }

        pthread_mutex_unlock(args->file_mutex);

        if (args->interval_ms > 0) {
            struct timespec delay;
            delay.tv_sec = args->interval_ms / 1000;
            delay.tv_nsec =
                (long)(args->interval_ms % 1000) * 1000000L;

            nanosleep(&delay, NULL);
        }
    }

    return NULL;
}

static int find_next_sale_id(void)
{
    FILE *file = fopen("sales.csv", "r");
    if (file == NULL) {
        return 1;
    }

    char line[512];
    int max_id = 0;
    int line_number = 0;

    while (fgets(line, sizeof(line), file) != NULL) {
        line_number++;

        if (line_number == 1) {
            continue; /* Заголовок */
        }

        int id;
        if (sscanf(line, "%d;", &id) == 1 && id > max_id) {
            max_id = id;
        }
    }

    fclose(file);
    return max_id + 1;
}

int main(int argc, char **argv)
{
    int thread_count = argc > 1 ? atoi(argv[1]) : 3;
    int interval_ms = argc > 2 ? atoi(argv[2]) : 500;
    int sales_per_thread = argc > 3 ? atoi(argv[3]) : 5;
    unsigned int seed =
        argc > 4 ? (unsigned int)strtoul(argv[4], NULL, 10) : 12345U;

    if (thread_count < 1 || thread_count > 100 ||
        interval_ms < 0 || sales_per_thread < 1) {
        fprintf(stderr,
                "Использование: %s [потоки] [интервал_мс] "
                "[продаж_на_поток] [seed]\n",
                argv[0]);
        return 1;
    }

    Product *products = calloc(MAX_PRODUCTS, sizeof(*products));
    Buyer *buyers = calloc(MAX_BUYERS, sizeof(*buyers));

    if (products == NULL || buyers == NULL) {
        fprintf(stderr, "Ошибка выделения памяти\n");
        free(products);
        free(buyers);
        return 1;
    }

    int product_count =
        load_products("products.csv", products, MAX_PRODUCTS);
    int buyer_count =
        load_buyers("buyers.csv", buyers, MAX_BUYERS);

    if (product_count <= 0 || buyer_count <= 0) {
        fprintf(stderr,
                "Не удалось загрузить products.csv или buyers.csv\n");
        free(products);
        free(buyers);
        return 1;
    }

    FILE *sales_file = fopen("sales.csv", "a+");
    if (sales_file == NULL) {
        perror("sales.csv");
        free(products);
        free(buyers);
        return 1;
    }

    if (fseek(sales_file, 0, SEEK_END) != 0) {
        perror("fseek");
        fclose(sales_file);
        free(products);
        free(buyers);
        return 1;
    }

    long file_size = ftell(sales_file);
    if (file_size == 0) {
        fprintf(sales_file,
                "sale_id;datetime;buyer_code;product_code\n");
        fflush(sales_file);
    }

    int next_sale_id = find_next_sale_id();
    pthread_mutex_t file_mutex = PTHREAD_MUTEX_INITIALIZER;

    pthread_t *threads = calloc((size_t)thread_count, sizeof(*threads));
    WorkerArgs *args = calloc((size_t)thread_count, sizeof(*args));
    int *created = calloc((size_t)thread_count, sizeof(*created));

    if (threads == NULL || args == NULL || created == NULL) {
        fprintf(stderr, "Ошибка выделения памяти\n");
        fclose(sales_file);
        free(threads);
        free(args);
        free(created);
        free(products);
        free(buyers);
        return 1;
    }

    log_message("Запуск симулятора: потоков=%d, продаж на поток=%d",
                thread_count, sales_per_thread);

    int created_count = 0;

    for (int i = 0; i < thread_count; i++) {
        args[i].thread_id = i + 1;
        args[i].sales_per_thread = sales_per_thread;
        args[i].interval_ms = interval_ms;
        args[i].seed = seed + (unsigned int)(i + 1) * 7919U;

        args[i].products = products;
        args[i].product_count = (size_t)product_count;
        args[i].buyers = buyers;
        args[i].buyer_count = (size_t)buyer_count;

        args[i].sales_file = sales_file;
        args[i].file_mutex = &file_mutex;
        args[i].next_sale_id = &next_sale_id;

        if (pthread_create(&threads[i], NULL,
                           simulate_sales, &args[i]) == 0) {
            created[i] = 1;
            created_count++;
        } else {
            log_message("Не удалось создать поток %d", i + 1);
        }
    }

    for (int i = 0; i < thread_count; i++) {
        if (created[i]) {
            pthread_join(threads[i], NULL);
        }
    }

    log_message("Симулятор завершил работу; потоков создано: %d",
                created_count);

    pthread_mutex_destroy(&file_mutex);
    fclose(sales_file);

    free(threads);
    free(args);
    free(created);
    free(products);
    free(buyers);

    return 0;
}
4. analyzer.c
Анализатор запускает отдельные потоки для общей суммы, популярности товаров, расходов покупателей и тенденций. Параметры можно менять во время работы.

#include "common.h"

#include <errno.h>
#include <pthread.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

typedef struct {
    double threshold;
    int interval_seconds;
    int group_by_month;
} Parameters;

typedef struct {
    pthread_mutex_t mutex;
    pthread_cond_t condition;
    Parameters parameters;
    int stop;
} ApplicationState;

typedef struct {
    char key[11];
    size_t count;
    double total;
} Trend;

typedef struct {
    size_t product_index;
    size_t count;
} ProductStat;

typedef struct {
    Sale *sales;
    size_t sale_count;

    Product *products;
    size_t product_count;
    Buyer *buyers;
    size_t buyer_count;

    Parameters parameters;
    size_t warning_count;

    double total_sales;
    size_t valid_sales;
    char first_datetime[32];
    char last_datetime[32];

    ProductStat *product_stats;
    double *buyer_totals;
    Trend *trends;
    size_t trend_count;
} Analysis;

static ApplicationState app_state = {
    PTHREAD_MUTEX_INITIALIZER,
    PTHREAD_COND_INITIALIZER,
    {100000.0, 10, 0},
    0
};

static int find_product_index(const Product *products,
                              size_t count, int code)
{
    for (size_t i = 0; i < count; i++) {
        if (products[i].code == code) {
            return (int)i;
        }
    }

    return -1;
}

static int find_buyer_index(const Buyer *buyers,
                            size_t count, int code)
{
    for (size_t i = 0; i < count; i++) {
        if (buyers[i].code == code) {
            return (int)i;
        }
    }

    return -1;
}

static void *input_thread(void *unused)
{
    (void)unused;

    char line[256];

    printf("Команды: threshold <сумма>, group day|month, "
           "interval <секунды>, quit\n");

    while (fgets(line, sizeof(line), stdin) != NULL) {
        char command[32] = "";
        char value[128] = "";

        int fields = sscanf(line, "%31s %127s", command, value);
        if (fields < 1) {
            continue;
        }

        if (strcmp(command, "quit") == 0) {
            pthread_mutex_lock(&app_state.mutex);
            app_state.stop = 1;
            pthread_cond_broadcast(&app_state.condition);
            pthread_mutex_unlock(&app_state.mutex);
            break;
        }

        int changed = 0;

        pthread_mutex_lock(&app_state.mutex);

        if (strcmp(command, "threshold") == 0) {
            if (fields < 2) {
                printf("Укажите сумму, например: threshold 50000\n");
            } else {
                char *end = NULL;
                double amount = strtod(value, &end);

                if (end != value && *end == '\0' && amount >= 0.0) {
                    app_state.parameters.threshold = amount;
                    changed = 1;
                } else {
                    printf("Некорректная сумма\n");
                }
            }
        } else if (strcmp(command, "group") == 0) {
            if (fields < 2) {
                printf("Укажите day или month\n");
            } else if (strcmp(value, "day") == 0) {
                app_state.parameters.group_by_month = 0;
                changed = 1;
            } else if (strcmp(value, "month") == 0) {
                app_state.parameters.group_by_month = 1;
                changed = 1;
            } else {
                printf("Укажите day или month\n");
            }
        } else if (strcmp(command, "interval") == 0) {
            if (fields < 2) {
                printf("Укажите интервал в секундах\n");
            } else {
                char *end = NULL;
                long seconds = strtol(value, &end, 10);

                if (end != value && *end == '\0' &&
                    seconds >= 1 && seconds <= 86400) {
                    app_state.parameters.interval_seconds = (int)seconds;
                    changed = 1;
                } else {
                    printf("Интервал должен быть от 1 до 86400 секунд\n");
                }
            }
        } else {
            printf("Неизвестная команда\n");
        }

        if (changed) {
            pthread_cond_broadcast(&app_state.condition);
        }

        pthread_mutex_unlock(&app_state.mutex);

        if (changed) {
            log_message("Параметры анализа изменены: %s", line);
            printf("Параметр сохранён; он будет применён в следующем отчёте.\n");
        }
    }

    pthread_mutex_lock(&app_state.mutex);
    app_state.stop = 1;
    pthread_cond_broadcast(&app_state.condition);
    pthread_mutex_unlock(&app_state.mutex);

    return NULL;
}

static void *total_worker(void *arg)
{
    Analysis *a = (Analysis *)arg;

    a->total_sales = 0.0;
    a->valid_sales = 0;
    a->first_datetime[0] = '\0';
    a->last_datetime[0] = '\0';

    for (size_t i = 0; i < a->sale_count; i++) {
        Sale *sale = &a->sales[i];

        if (!sale->valid) {
            continue;
        }

        a->total_sales += a->products[sale->product_index].price;
        a->valid_sales++;

        if (a->first_datetime[0] == '\0' ||
            strcmp(sale->datetime, a->first_datetime) < 0) {
            snprintf(a->first_datetime, sizeof(a->first_datetime),
                     "%s", sale->datetime);
        }

        if (a->last_datetime[0] == '\0' ||
            strcmp(sale->datetime, a->last_datetime) > 0) {
            snprintf(a->last_datetime, sizeof(a->last_datetime),
                     "%s", sale->datetime);
        }
    }

    return NULL;
}

static void *popularity_worker(void *arg)
{
    Analysis *a = (Analysis *)arg;

    for (size_t i = 0; i < a->product_count; i++) {
        a->product_stats[i].product_index = i;
        a->product_stats[i].count = 0;
    }

    for (size_t i = 0; i < a->sale_count; i++) {
        if (a->sales[i].valid) {
            a->product_stats[a->sales[i].product_index].count++;
        }
    }

    return NULL;
}

static void *buyers_worker(void *arg)
{
    Analysis *a = (Analysis *)arg;

    for (size_t i = 0; i < a->buyer_count; i++) {
        a->buyer_totals[i] = 0.0;
    }

    for (size_t i = 0; i < a->sale_count; i++) {
        Sale *sale = &a->sales[i];

        if (sale->valid) {
            a->buyer_totals[sale->buyer_index] +=
                a->products[sale->product_index].price;
        }
    }

    return NULL;
}

static int compare_trends(const void *left, const void *right)
{
    const Trend *a = (const Trend *)left;
    const Trend *b = (const Trend *)right;
    return strcmp(a->key, b->key);
}

static void *trends_worker(void *arg)
{
    Analysis *a = (Analysis *)arg;
    a->trend_count = 0;

    for (size_t i = 0; i < a->sale_count; i++) {
        Sale *sale = &a->sales[i];

        if (!sale->valid) {
            continue;
        }

        Trend *trend = &a->trends[a->trend_count++];
        memset(trend, 0, sizeof(*trend));

        if (a->parameters.group_by_month) {
            memcpy(trend->key, sale->datetime, 7);
            trend->key[7] = '\0';
        } else {
            memcpy(trend->key, sale->datetime, 10);
            trend->key[10] = '\0';
        }

        trend->count = 1;
        trend->total = a->products[sale->product_index].price;
    }

    qsort(a->trends, a->trend_count, sizeof(*a->trends), compare_trends);

    size_t output_count = 0;

    for (size_t i = 0; i < a->trend_count; i++) {
        if (output_count > 0 &&
            strcmp(a->trends[output_count - 1].key,
                   a->trends[i].key) == 0) {
            a->trends[output_count - 1].count += a->trends[i].count;
            a->trends[output_count - 1].total += a->trends[i].total;
        } else {
            if (output_count != i) {
                a->trends[output_count] = a->trends[i];
            }
            output_count++;
        }
    }

    a->trend_count = output_count;
    return NULL;
}

static int compare_popular(const void *left, const void *right)
{
    const ProductStat *a = (const ProductStat *)left;
    const ProductStat *b = (const ProductStat *)right;

    if (a->count < b->count) return 1;
    if (a->count > b->count) return -1;
    if (a->product_index < b->product_index) return -1;
    if (a->product_index > b->product_index) return 1;
    return 0;
}

static int compare_unpopular(const void *left, const void *right)
{
    const ProductStat *a = (const ProductStat *)left;
    const ProductStat *b = (const ProductStat *)right;

    if (a->count > b->count) return 1;
    if (a->count < b->count) return -1;
    if (a->product_index < b->product_index) return -1;
    if (a->product_index > b->product_index) return 1;
    return 0;
}

static void write_product_list(FILE *out, const char *title,
                               ProductStat *stats, size_t count,
                               const Product *products, int popular)
{
    fprintf(out, "\n%s\n", title);

    if (count == 0) {
        fprintf(out, "Нет товаров в справочнике.\n");
        return;
    }

    qsort(stats, count, sizeof(*stats),
          popular ? compare_popular : compare_unpopular);

    size_t limit = count < 5 ? count : 5;

    for (size_t i = 0; i < limit; i++) {
        const Product *product = &products[stats[i].product_index];

        fprintf(out, "%zu. %s, код %d — продаж: %zu\n",
                i + 1, product->name, product->code, stats[i].count);
    }
}

static void *report_worker(void *arg)
{
    Analysis *a = (Analysis *)arg;
    FILE *out = fopen("report.txt", "w");

    if (out == NULL) {
        log_message("Ошибка: не удалось создать report.txt");
        return NULL;
    }

    fprintf(out, "ОТЧЁТ ПО ПРОДАЖАМ\n");
    fprintf(out, "=================\n");
    fprintf(out, "Период: %s — %s\n",
            a->first_datetime[0] ? a->first_datetime : "нет данных",
            a->last_datetime[0] ? a->last_datetime : "нет данных");
    fprintf(out, "Корректных продаж: %zu\n", a->valid_sales);
    fprintf(out, "Общая сумма продаж: %.2f\n", a->total_sales);
    fprintf(out, "Порог покупок: %.2f\n", a->parameters.threshold);
    fprintf(out, "Группировка тенденций: %s\n",
            a->parameters.group_by_month ? "по месяцам" : "по дням");
    fprintf(out, "Некорректных или неизвестных записей: %zu\n",
            a->warning_count);

    ProductStat *popular =
        calloc(a->product_count ? a->product_count : 1, sizeof(*popular));
    ProductStat *unpopular =
        calloc(a->product_count ? a->product_count : 1, sizeof(*unpopular));

    if (popular != NULL && unpopular != NULL) {
        memcpy(popular, a->product_stats,
               a->product_count * sizeof(*popular));
        memcpy(unpopular, a->product_stats,
               a->product_count * sizeof(*unpopular));

        write_product_list(out, "Пять самых популярных товаров:",
                           popular, a->product_count, a->products, 1);
        write_product_list(out, "Пять самых непопулярных товаров:",
                           unpopular, a->product_count, a->products, 0);
    } else {
        fprintf(out, "\nНе удалось выделить память для рейтинга товаров.\n");
    }

    free(popular);
    free(unpopular);

    fprintf(out, "\nПокупатели, потратившие больше порога:\n");

    int found_buyer = 0;
    for (size_t i = 0; i < a->buyer_count; i++) {
        if (a->buyer_totals[i] > a->parameters.threshold) {
            fprintf(out, "- %s, код %d — сумма покупок: %.2f\n",
                    a->buyers[i].name,
                    a->buyers[i].code,
                    a->buyer_totals[i]);
            found_buyer = 1;
        }
    }

    if (!found_buyer) {
        fprintf(out, "Таких покупателей нет.\n");
    }

    fprintf(out, "\nТенденции продаж:\n");

    if (a->trend_count == 0) {
        fprintf(out, "Нет данных для анализа.\n");
    } else {
        for (size_t i = 0; i < a->trend_count; i++) {
            fprintf(out, "- %s: продаж %zu, сумма %.2f\n",
                    a->trends[i].key,
                    a->trends[i].count,
                    a->trends[i].total);
        }
    }

    fclose(out);
    log_message("Отчёт report.txt сформирован");
    return NULL;
}

static void run_analysis_cycle(Product *products, size_t product_count,
                               Buyer *buyers, size_t buyer_count)
{
    Sale *sales = calloc(MAX_SALES, sizeof(*sales));
    if (sales == NULL) {
        log_message("Ошибка выделения памяти для продаж");
        return;
    }

    size_t malformed = 0;
    int loaded = load_sales("sales.csv", sales, MAX_SALES, &malformed);

    if (loaded < 0) {
        free(sales);
        return;
    }

    size_t sale_count = (size_t)loaded;
    size_t warnings = malformed;

    for (size_t i = 0; i < sale_count; i++) {
        int product_index =
            find_product_index(products, product_count,
                               sales[i].product_code);
        int buyer_index =
            find_buyer_index(buyers, buyer_count,
                             sales[i].buyer_code);

        if (product_index < 0 || buyer_index < 0) {
            warnings++;
            log_message("Продажа %d пропущена: неизвестный код товара "
                        "или покупателя", sales[i].id);
            continue;
        }

        sales[i].valid = 1;
        sales[i].product_index = product_index;
        sales[i].buyer_index = buyer_index;
    }

    Parameters snapshot;

    pthread_mutex_lock(&app_state.mutex);
    snapshot = app_state.parameters;
    pthread_mutex_unlock(&app_state.mutex);

    Analysis analysis = {0};

    analysis.sales = sales;
    analysis.sale_count = sale_count;
    analysis.products = products;
    analysis.product_count = product_count;
    analysis.buyers = buyers;
    analysis.buyer_count = buyer_count;
    analysis.parameters = snapshot;
    analysis.warning_count = warnings;

    analysis.product_stats =
        calloc(product_count ? product_count : 1,
               sizeof(*analysis.product_stats));
    analysis.buyer_totals =
        calloc(buyer_count ? buyer_count : 1,
               sizeof(*analysis.buyer_totals));
    analysis.trends =
        calloc(sale_count ? sale_count : 1,
               sizeof(*analysis.trends));

    if (analysis.product_stats == NULL ||
        analysis.buyer_totals == NULL ||
        analysis.trends == NULL) {
        log_message("Ошибка выделения памяти для анализа");
        free(analysis.product_stats);
        free(analysis.buyer_totals);
        free(analysis.trends);
        free(sales);
        return;
    }

    log_message("Начат анализ: записей продаж=%zu", sale_count);

    void *(*workers[4])(void *) = {
        total_worker,
        popularity_worker,
        buyers_worker,
        trends_worker
    };

    pthread_t threads[4];
    int created[4] = {0, 0, 0, 0};

    for (int i = 0; i < 4; i++) {
        if (pthread_create(&threads[i], NULL, workers[i], &analysis) == 0) {
            created[i] = 1;
        } else {
            log_message("Не удалось создать поток анализа %d; "
                        "функция запущена в основном потоке", i + 1);
            workers[i](&analysis);
        }
    }

    for (int i = 0; i < 4; i++) {
        if (created[i]) {
            pthread_join(threads[i], NULL);
        }
    }

    pthread_t report_thread;

    if (pthread_create(&report_thread, NULL,
                       report_worker, &analysis) == 0) {
        pthread_join(report_thread, NULL);
    } else {
        log_message("Не удалось создать поток отчёта; "
                    "отчёт сформирован в основном потоке");
        report_worker(&analysis);
    }

    log_message("Цикл анализа завершён");

    free(analysis.product_stats);
    free(analysis.buyer_totals);
    free(analysis.trends);
    free(sales);
}

int main(void)
{
    Product *products = calloc(MAX_PRODUCTS, sizeof(*products));
    Buyer *buyers = calloc(MAX_BUYERS, sizeof(*buyers));

    if (products == NULL || buyers == NULL) {
        fprintf(stderr, "Ошибка выделения памяти\n");
        free(products);
        free(buyers);
        return 1;
    }

    int product_count =
        load_products("products.csv", products, MAX_PRODUCTS);
    int buyer_count =
        load_buyers("buyers.csv", buyers, MAX_BUYERS);

    if (product_count < 0 || buyer_count < 0) {
        fprintf(stderr, "Не удалось загрузить справочники\n");
        free(products);
        free(buyers);
        return 1;
    }

    pthread_t input;
    if (pthread_create(&input, NULL, input_thread, NULL) != 0) {
        fprintf(stderr, "Не удалось создать поток ввода команд\n");
        free(products);
        free(buyers);
        return 1;
    }

    log_message("Анализатор запущен");

    for (;;) {
        pthread_mutex_lock(&app_state.mutex);
        int should_stop = app_state.stop;
        pthread_mutex_unlock(&app_state.mutex);

        if (should_stop) {
            break;
        }

        run_analysis_cycle(products, (size_t)product_count,
                           buyers, (size_t)buyer_count);

        pthread_mutex_lock(&app_state.mutex);

        if (!app_state.stop) {
            time_t deadline =
                time(NULL) + app_state.parameters.interval_seconds;
            struct timespec timeout = {deadline, 0};

            while (!app_state.stop) {
                int result = pthread_cond_timedwait(
                    &app_state.condition,
                    &app_state.mutex,
                    &timeout);

                if (result == ETIMEDOUT) {
                    break;
                }

                deadline =
                    time(NULL) + app_state.parameters.interval_seconds;
                timeout.tv_sec = deadline;
                timeout.tv_nsec = 0;
            }
        }

        should_stop = app_state.stop;
        pthread_mutex_unlock(&app_state.mutex);

        if (should_stop) {
            break;
        }
    }

    pthread_join(input, NULL);
    log_message("Анализатор завершил работу");

    pthread_mutex_destroy(&app_state.mutex);
    pthread_cond_destroy(&app_state.condition);

    free(products);
    free(buyers);

    return 0;
}
